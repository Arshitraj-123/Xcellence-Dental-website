# Xcellence Dental Clinic Environment Configuration
# Copy this file to .env.local for local overrides.

# Clinic WhatsApp Contact Number (digits only, including country code: default 919643365651)
VITE_WHATSAPP_NUMBER=919643365651

# Form Submission Endpoint
# Leave empty for client-side triage modal ("Review and send" via WhatsApp / Email / Phone).
# When your backend API or Formspree endpoint is ready next week, set the full URL here:
# VITE_FORM_ENDPOINT=https://formspree.io/f/your_form_id
# VITE_FORM_ENDPOINT=https://api.xcellencedentalharidwar.com/v1/leads
VITE_FORM_ENDPOINT=
